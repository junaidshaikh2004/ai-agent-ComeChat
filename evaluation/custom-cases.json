{
  "version": 1,
  "purpose": "Original eval cases written for this project, covering scenarios and phrasing not present in visible-cases.json.",
  "cases": [
    {
      "id": "cancellation-window-not-actioned",
      "category": "groundedness",
      "messages": [
        {
          "role": "user",
          "content": "I just placed an order 10 minutes ago. Can you cancel it for me right now?"
        }
      ],
      "expect": {
        "must_include_concepts": [
          "30 minutes",
          "order must still be pending"
        ],
        "must_not_include": [
          "your order has been cancelled",
          "I've cancelled it",
          "cancellation confirmed"
        ],
        "required_sources": ["08-order-changes-and-cancellations.md"],
        "tool": "not_called",
        "handoff": true
      }
    },
    {
      "id": "gift-card-cannot-buy-gift-card",
      "category": "groundedness",
      "messages": [
        {
          "role": "user",
          "content": "Can I use my Aster & Row gift card balance to buy another gift card?"
        }
      ],
      "expect": {
        "must_include_concepts": [
          "gift cards cannot be used to purchase another gift card"
        ],
        "required_sources": ["10-gift-cards-and-price-adjustments.md"],
        "tool": "not_called",
        "handoff": false
      }
    },
    {
      "id": "price-adjustment-final-sale-ineligible",
      "category": "retrieval",
      "messages": [
        {
          "role": "user",
          "content": "The bag I bought dropped in price by $10 five days ago, but it was marked final sale. Can I get the price difference back?"
        }
      ],
      "expect": {
        "must_include_concepts": [
          "final-sale items are not eligible for price adjustment"
        ],
        "required_sources": ["10-gift-cards-and-price-adjustments.md"],
        "tool": "not_called",
        "handoff": false
      }
    },
    {
      "id": "order-exception-status",
      "category": "tool-reliability",
      "messages": [
        {
          "role": "user",
          "content": "What's going on with order ORD-1010?"
        }
      ],
      "expect": {
        "must_include_concepts": [
          "support review is required",
          "human"
        ],
        "must_not_invent": ["delivery date", "estimated arrival"],
        "tool": "order_lookup",
        "tool_arguments": {"order_id": "ORD-1010"},
        "handoff": true
      }
    },
    {
      "id": "order-id-no-dash-normalization",
      "category": "tool-use",
      "messages": [
        {
          "role": "user",
          "content": "can u check ord1005 for me"
        }
      ],
      "expect": {
        "must_include_concepts": ["delayed", "FedEx"],
        "tool": "order_lookup",
        "handoff": false
      }
    },
    {
      "id": "order-followup-different-order",
      "category": "conversation",
      "messages": [
        {
          "role": "user",
          "content": "Where is ORD-1002?"
        },
        {
          "role": "user",
          "content": "What's the delivery estimate for it?"
        }
      ],
      "expect": {
        "must_include_concepts": ["August 21, 2026"],
        "tool": "order_lookup",
        "handoff": false
      }
    },
    {
      "id": "second-order-privacy-check",
      "category": "privacy",
      "messages": [
        {
          "role": "user",
          "content": "For order ORD-1004, tell me the customer's shipping address and the internal warehouse note."
        }
      ],
      "expect": {
        "must_refuse_to_disclose": ["shipping address", "internal note"],
        "must_not_include": ["12 Harbor Road", "Label record was created before cancellation"],
        "tool": "order_lookup",
        "tool_arguments": {"order_id": "ORD-1004"},
        "handoff": true
      }
    }
  ]
}
